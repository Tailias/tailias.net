---
import Base from "@layouts/Base.astro";
import Kickoff from "@components/Kickoff.astro";
import Section from "@components/Section.astro";
import Badge from "@components/Badge.astro";

import kickoff_image from "@images/kickoff-2025.jpg"
---

<Base title="Links" description="Contact Tailias">
    <Kickoff contentAlign="left" backgroundImage={kickoff_image} backgroundAlt="A photo of a coastline" hideScrollButton={true}>
        <h2 style="text-decoration: underline">My Links</h2>
        <p>
            You can contact me using the links below or emailing me directly at <a href="mailto:tailias.net@proton.me">tailias.net@proton.me</a><br/>
        </p>
        <p>
            This page contains my official social media accounts.<br/>
            This page is out of date. If you're concerned about whether a social account is mine or not, please contact me.
        </p>
        <div class="badge-box">
            <Badge
                    src="/88x31/Tailias-Badge.png"
                    label="My Website (oh look, you're already here dumb cunt)"
                    href="https://tailias.net/"
            />
            <Badge
                    src="/88x31/bluesky.png"
                    label="Bluesky"
                    href="https://bsky.app/profile/tailias.net/"
            />
            <Badge
                    src="/88x31/YouTube.png"
                    label="YouTube"
                    href="https://youtube.com/@Tailias/"
            />
            <Badge
                    src="/88x31/Twitch.png"
                    label="Twitch (inactive)"
                    href="https://twitch.tv/tailiasdotnet/"
            />
            <Badge
                    src="/88x31/twitterbutton.gif"
                    label="Twitter (Fuck X) (inactive)"
                    href="https://twitter.com/tailiasdotnet/"
            />
        </div>
        <p>
            <br/>
            Also make sure to check out my friends :D
        </p>
        <div class="badge-box">
            <Badge
                    src="/88x31/chronos.png"
                    label="ChronosExile"
                    href="https://chronos.blog/"
            />
            <Badge
                    src="/88x31/blahaj_certified.png"
                    label="Equinoxx"
                    href="https://equinoxx.dev/"
            />
            <Badge
                    src="/88x31/gordinator.png"
                    label="Gordinator"
                    href="https://gordinator.org/"
            />
            <Badge
                    src="/88x31/hsp.gif"
                    label="hemisputnik"
                    href="https://512b.dev/hsp/"
            />
            <Badge
                    src="/88x31/kiiatto-net.png"
                    label="kiiatto"
                    href="https://kiiatto.net/"
            />
        </div>
    </Kickoff>
</Base>

<style>
    .badge-box {
        max-width: 100%;
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 15px;
    }
</style>